            char[,,] board = new char[5, 5, 5];
            for (int i = 0; i < board.GetLength(0); i++)
            {
                for (int j = 0; j < board.GetLength(1); j++)
                {
                    for(int k = 0; k<board.GetLength(2); k++)
                    {
                        board[i, j, k] = '.';
                    }
                }
            }

            //hedef puzzle için 3 boyutlu dizi
            char[, ,] puzzle = { {{ '.', '.', '.', '.', '.' },
                                 { '.', '.', '.', '.', '.' },
                                 { '.', '.', '.', '.', '.' },
                                 { 'x', 'x', 'x', '.', '.' },
                                 { 'x', 'x', 'x', '.', '.' }},

                                {{ '.', '.', '.', '.', '.' },
                                 { '.', '.', '.', '.', '.' },
                                 { 'x', '.', '.', '.', '.' },
                                 { 'x', '.', '.', '.', '.' },
                                 { 'x', 'x', 'x', '.', '.' }},

                                {{ '.', '.', '.', '.', '.' },
                                 { '.', '.', '.', '.', '.' },
                                 { 'x', '.', '.', '.', '.' },
                                 { 'x', '.', '.', '.', '.' },
                                 { 'x', 'x', 'x', '.', '.' }},

                                {{ '.', '.', '.', '.', '.' },
                                 { '.', '.', '.', '.', '.' },
                                 { 'x', '.', '.', '.', '.' },
                                 { 'x', '.', '.', '.', '.' },
                                 { 'x', 'x', 'x', '.', '.' }},

                                {{ '.', '.', '.', '.', '.' },
                                 { '.', '.', '.', '.', '.' },
                                 { '.', '.', '.', '.', '.' },
                                 { 'x', 'x', 'x', '.', '.' },
                                 { 'x', 'x', 'x', '.', '.' }}};

            //cursor1 için 3 boyutlu dizi
            char[,,] cursor1 ={{{ '.', '.', '.'},
                                { 'x', '.', '.'},
                                { 'x', 'x', '.'}},

                               {{ '.', '.', '.'},
                                { '.', '.', '.'},
                                { '.', '.', '.'}},

                               {{ '.', '.', '.'},
                                { '.', '.', '.'},
                                { '.', '.', '.'}}};

            //ekranı her ohyun dögüsünde silmemiz gerekiyor bunun için fonksiyon
            clearScreen(space);

            //fonksiyonları çağırarak puzzle ve cursoru yazdırmak
            DrawVolume(space, puzzle, cupe, 28, 0);
