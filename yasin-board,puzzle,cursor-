        {
            //ekranın kaymasını engellemek için "AI"
            Console.SetBufferSize(200, 80);
            Console.SetWindowSize(150, 60);

            //standart bir küp string olarak saklanıyor
            string[] cupe =
                {
                "##+-----+",
                "#/     /|",
                "+-----+ |",
                "| 4 4 | +",
                "| 4 4 |/",
                "+-----+"
                    };

            //tüm ekranı dizi olarka karelere bölüyoruz
            char[,] space = new char[60, 100];

