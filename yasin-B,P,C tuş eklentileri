        static void drawCupe(char[,] tablo, string[] sablon, int satir0, int sutun0)
        {//oyle bir fonksiyonki standart küp ü kullanarak yan yana alt altta yazdırmak için ekrana tanımlama işlemi
            for (int i = 0; i < sablon.Length; i++)
            {
                for (int j = 0; j < sablon[i].Length; j++)
                {//küp şanlonunda sol üstteki 3 boşluk çizdirirken diğer küplerin üstne biniyordu bu yüzden oralara bişey tanımlayıp yazdırmıyoruz
                    if (sablon[i][j] != '#')
                    tablo[i + satir0, j + sutun0] = sablon[i][j];
                }
            }
        }
        static void DrawVolume(char[,] ekran, char[,,] veri, string[] sablon, int ustKayma, int solKayma)
        {//öyle fonksiyonki cursor ve puzzle ı ekranın farklı yerlerine koymak için kayma işlemini yüklüyor
            for (int i = veri.GetLength(0)-1; i >= 0; i--)
            {
                for (int j = veri.GetLength(1)-1; j >= 0; j--)
                {
                    for (int k = 0; k <= veri.GetLength(2)-1; k++)
                    {
                        int satir = j * 3 + (veri.GetLength(0)-1 - i) * 2 + ustKayma;
                        int sutun = k * 6 + i * 2 + solKayma;

                        if (veri[i, j, k] == 'x')
                        {
                            drawCupe(ekran, sablon, satir, sutun);
                        }
                    }
                }
            }
        }

        static void Yerlestir(char[,,] hedef, char[,,] parca, int cx, int cy, int cz)
        {// bu fonksiyon space basıldığında o anki parcanın dizi degerlerini board dizisine kaydediyor
            for (int a = 0; a < parca.GetLength(0); a++)
            {//burda 3 boyut için 3 loop yapıyoruz ardından parcanın x degerlerini boardumuzun dizisine kaydediyoruz
                for (int b = 0; b < parca.GetLength(1); b++)
                {
                    for (int c = 0; c < parca.GetLength(2); c++)
                    {
                        if (parca[a, b, c] == 'x')
                        {
                            hedef[cz + a, 2 + b - cy, cx + c] = 'x';
                        }
                    }
                }
            }
        }
        static void clearScreen(char[,] tablo)
        {
            //tüm consol ekranını kare kare bölmüştük burda o kareleri boşluk yapıp siliyoruz
            for (int i = 0; i < tablo.GetLength(0); i++)
            {
                for (int j = 0; j < tablo.GetLength(1); j++)
                {
                    tablo[i, j] = ' ';
                }
            }
        }
        static void printScreen(char[,] tablo)
        {
            //boşluklara atadığımız küpleri yazdırma kısmı
            for (int i = 0; i < tablo.GetLength(0); i++)
            {
                Console.SetCursorPosition(0, i);

                for (int j = 0; j < tablo.GetLength(1); j++)
                {
                    Console.Write(tablo[i, j]);
                }
            }


            Console.SetCursorPosition(0, 31);// bunlar cursor puzzle ve board alanını bölmek için çizgilerin yazımı
            for (int i = 1; i <= 179; i++)
                Console.Write("-");
            for (int i = 1; i <= 30; i++)
            {
                Console.SetCursorPosition(80, 0 + i);
                Console.Write("|");
            }
        }
