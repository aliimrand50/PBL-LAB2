int nx = 5, ny = 5, nz = 5;

string[] template = {
                      "  +-----+",
                      " /     /|",
                      "+-----+ |",
                      "| # # | +",
                      "| # # |/",
                      "+-----+"
                    };

int H = (ny - 1) * 3 + (nz - 1) * 2 + 6;
int W = (nx - 1) * 6 + (nz - 1) * 2 + 9;
char[,] ch = new char[H, W];

for (int i = 0; i < H; i++)
    for (int j = 0; j < W; j++)
        ch[i, j] = ' ';


for (int z = nz - 1; z >= 0; z--)
    for (int y = 0; y < ny; y++)
        for (int x = 0; x < nx; x++)
        {
            if (puzzle[x, y, z] == 1)
            {
                int c = x * 6 + z * 2;
                int r = (ny - 1 - y) * 3 + (nz - 1 - z) * 2;

                for (int i = 0; i < 6; i++)
                {
                    bool started = false;
                    for (int k = 0; k < template[i].Length; k++)
                    {
                        char t = template[i][k];
                        if (t != ' ') 
                            started = true;
                        if (!started) 
                            continue;
                        if (t == '#') 
                            t = '1';
                        ch[r + i, c + k] = t;
                    }
                }
            }
        }

         
for (int i = 0; i < H; i++)
{
    for (int j = 0; j < W; j++)
    {
        Console.SetCursorPosition(2 + j, 2 + i);
        Console.Write(ch[i, j]);
    }
}

